+TRIVIAL = r"(?:-?\d[\d_.]*(?:f32|f64|u\d+|i\d+|usize)?|Default::default\(\)|String::new\(\)|Vec::new\(\)|vec!\[\]|None|false|true|\"[^\"]*\"|\(\)|0\.0)"
