+            groups = []
+            for a, b, oa, ob, c in ms[1:]:
+                if a <= end + 3:
+                    end = max(end, b)
+                    ctl += c
+                else:
+                    groups.append((start, end, o_start, ctl))
+                    start, end, o_start, ctl = a, b, oa, c
+            groups.append((start, end, o_start, ctl))
+            try:
+                src = (root / rp).read_text(errors="replace").splitlines()
+            except OSError:
+                continue
