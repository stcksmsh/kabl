+# --------------------------------------------------------------------------- thin wrappers
+
+def _param_names(params: str) -> list[str]:
+    out = []
+    for p in params.split(","):
+        p = p.strip()
+        if not p or p in ("self", "&self", "&mut self", "mut self"):
+            continue
+        n = re.match(r"(?:mut\s+)?(\w+)\s*:", p) or re.match(r"(\w+)\s*(?::|=|$)", p)
+        if n:
+            out.append(n.group(1))
+    return out
