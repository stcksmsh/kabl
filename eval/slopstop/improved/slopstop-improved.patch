+                scope = "*.py"
+                if lang == "rust":  # call sites outside the crate cannot see a private wrapper; names collide repo-wide
+                    cm = re.match(r"^(.*?)/src/", p)
+                    scope = f":(glob){cm.group(1)}/**/*.rs" if cm else "*.rs"
